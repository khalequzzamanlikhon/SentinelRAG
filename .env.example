# ── PRIMARY LLM: Groq (https://console.groq.com) ──────────────────────────
# Free tier: 14,400 requests/day. Get a key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── FALLBACK LLM: Gemini (optional) ───────────────────────────────────────
# Uncomment and set if you want Gemini as a fallback when Groq rate-limits.
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# ── EMBEDDINGS: Local sentence-transformers (no API key needed) ──────────
# The model is downloaded once on first use and cached locally (~1.3 GB).
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── QDRANT ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_MODE=embedded           # "embedded" = on-disk, "server" = Docker
COLLECTION_NAME=sentinel_rag_docs

# ── RETRIEVAL TUNING ──────────────────────────────────────────────────────
TOP_K_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.7
MAX_LOOP_COUNT=3

# ── LLM CALL RESILIENCE ───────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── CACHE ─────────────────────────────────────────────────────────────────
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=500

# ── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
